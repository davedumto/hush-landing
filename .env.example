# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Discord webhook URL to post feedback embeds to
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxxxxxxxxxxx/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password for the /admin login form
ADMIN_PASSWORD=change-me

# Bearer token for scripting access to /api/admin/list
ADMIN_TOKEN=change-me-too

# Secret used to sign the admin session cookie (use a long random string)
COOKIE_SECRET=replace-with-a-long-random-string

# Salt used when hashing IP addresses and client UUIDs for rate limiting
IP_HASH_SALT=replace-with-a-long-random-string
